[Unit]
Description=Multi-Cloud Spot VM Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/multi-cloud-spot-monitor
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=spot-monitor
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
