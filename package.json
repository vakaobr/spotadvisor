{
  "name": "multi-cloud-spot-monitor",
  "version": "1.0.0",
  "description": "Monitor Spot/Preemptible VM rates across AWS, Azure, and GCP",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.js\"",
    "test": "node ./scripts/smoke-test.js",
    "smoke-test": "bash ./scripts/smoke-test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.400.0",
    "@aws-sdk/client-pricing": "^3.400.0",
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/identity": "^4.12.0",
    "@google-cloud/compute": "^6.3.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "sqlite3": "^5.1.7",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.8"
  }
}
